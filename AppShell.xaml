<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinanceTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinanceTracker.Pages"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Accounts"
            ContentTemplate="{DataTemplate local:AccountsPage}"
            Route="AccountsPage" />

        <ShellContent
            Title="Add Expense"
            ContentTemplate="{DataTemplate local:ExpensePage}"
            Route="ExpensePage" />

        <ShellContent
            Title="Income"
            ContentTemplate="{DataTemplate local:IncomePage}"
            Route="IncomePage" />

        <ShellContent
            Title="Reports"
            ContentTemplate="{DataTemplate local:ReportsPage}"
            Route="ReportsPage" />
    </TabBar>

</Shell>
