<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FinanceTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FinanceTracker.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource PageBackground}"
    Shell.ForegroundColor="{StaticResource TextPrimary}"
    Shell.TitleColor="{StaticResource TextPrimary}"
    Shell.DisabledColor="{StaticResource TextMuted}"
    Shell.UnselectedColor="{StaticResource TextMuted}"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Accent}"
    Shell.TabBarUnselectedColor="{StaticResource TextMuted}"
    Shell.TabBarTitleColor="{StaticResource Accent}">

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="icons/home.png"
            Route="HomePage"
            ContentTemplate="{DataTemplate local:HomePage}" />

        <!-- Reports -->
        <ShellContent
            Title="Reports"
            Icon="icons/analytics.png"
            Route="ReportsPage"
            ContentTemplate="{DataTemplate local:ReportsPage}" />

        <!-- Settings -->
        <ShellContent
            Title="Settings"
            Icon="icons/settings.png"
            Route="SettingsPage"
            ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>
</Shell>
