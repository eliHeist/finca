<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
    x:DataType="vm:CategoriesViewModel"
    Title="Categories">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="16">

        <VerticalStackLayout Spacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Categories"
                       FontSize="28"
                       FontAttributes="Bold" />

                <Label Text="Organize income and expenses."
                       TextColor="Gray" />
            </VerticalStackLayout>

            <Button Text="+ Add category"
                    Clicked="OnAddClicked" />
        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Categories}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     Spacing="8"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                    <Label Text="No categories yet."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">
                    <Border Padding="16"
                            Margin="0,0,0,12"
                            Stroke="#DDDDDD"
                            StrokeThickness="1">

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}"
                                           FontSize="17"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding KindLabel}"
                                           TextColor="Gray"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding IsActive, StringFormat='Active: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">
                                <Button Text="Rename"
                                        Clicked="OnRenameClicked"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="{Binding StatusAction}"
                                        Clicked="OnToggleActiveClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
