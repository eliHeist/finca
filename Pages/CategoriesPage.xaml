<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
    x:DataType="vm:CategoriesViewModel"
    Title="Categories"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid
        Padding="22,28"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="18">

        <!-- Header -->
        <VerticalStackLayout Spacing="16">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>

                    <Image
                        Source="icons/chevron_left.png"
                        WidthRequest="22"
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="4"
                    VerticalOptions="Center">

                    <Label
                        Text="Categories"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Label
                        Text="Organize your income and expenses."
                        FontSize="13"
                        TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Grid>

            <Button
                Text="+  Add category"
                Clicked="OnAddClicked"
                BackgroundColor="{StaticResource Accent}"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="50" />

        </VerticalStackLayout>

        <!-- Error message -->
        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="{StaticResource Error}"
            FontSize="13"
            LineBreakMode="WordWrap" />

        <!-- Categories list -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Categories}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24"
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        Color="{StaticResource Accent}" />

                    <Border
                        WidthRequest="64"
                        HeightRequest="64"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HorizontalOptions="Center">

                        <Image
                            Source="icons/tags.svg"
                            WidthRequest="30"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Text="No categories yet"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add categories to keep your transactions organized."
                        FontSize="13"
                        TextColor="{StaticResource TextMuted}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryRow">

                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="16">

                            <!-- Category details -->
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">

                                <Border
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#2DF2390A"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">

                                    <Image
                                        Source="icons/tags.svg"
                                        WidthRequest="23"
                                        HeightRequest="23"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Text="{Binding KindLabel}"
                                        FontSize="12"
                                        TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <!-- Status badge -->
                                <Border
                                    Grid.Column="2"
                                    Padding="9,5"
                                    BackgroundColor="#2035D995"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="Active"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Success}">

                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding IsActive}"
                                                Value="False">
                                                <Setter
                                                    Property="Text"
                                                    Value="Inactive" />
                                                <Setter
                                                    Property="TextColor"
                                                    Value="{StaticResource TextMuted}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding IsActive}"
                                            Value="False">
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="{StaticResource PageBackground}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{StaticResource Border}" />

                            <!-- Actions -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10">

                                <Button
                                    Text="Rename"
                                    Clicked="OnRenameClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource PageBackground}"
                                    TextColor="{StaticResource TextPrimary}"
                                    BorderColor="{StaticResource Border}"
                                    BorderWidth="1"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="42" />

                                <Button
                                    Grid.Column="1"
                                    Text="{Binding StatusAction}"
                                    Clicked="OnToggleActiveClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource Accent}"
                                    BorderColor="{StaticResource Accent}"
                                    BorderWidth="1"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="42" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
