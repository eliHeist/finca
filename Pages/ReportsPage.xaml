<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reports"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="22,28" Spacing="24">

            <!-- Header -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Reports"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Understand your income and spending."
                    FontSize="14"
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <!-- Report period -->
            <Border
                Padding="18"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Report period"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="Start date"
                                FontSize="13"
                                TextColor="{StaticResource TextMuted}" />

                            <Border
                                Padding="8,2"
                                BackgroundColor="{StaticResource PageBackground}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">

                                <DatePicker
                                    Date="{Binding StartDate}"
                                    Format="dd MMM yyyy"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="8">

                            <Label
                                Text="End date"
                                FontSize="13"
                                TextColor="{StaticResource TextMuted}" />

                            <Border
                                Padding="8,2"
                                BackgroundColor="{StaticResource PageBackground}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">

                                <DatePicker
                                    Date="{Binding EndDate}"
                                    Format="dd MMM yyyy"
                                    TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="Transparent"
                                    FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button
                        Text="Calculate report"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource Accent}"
                        HorizontalOptions="Center" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{StaticResource Error}"
                        FontSize="13"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Total funds summary -->
            <Border
                Padding="20"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Accent}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="TOTAL FUNDS"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="{StaticResource TextMuted}" />

                    <Label
                        Text="{Binding TotalFunds}"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="Genuine income plus expenses covered by external sources."
                        FontSize="13"
                        TextColor="{StaticResource TextMuted}"
                        LineBreakMode="WordWrap" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Border}"
                        Margin="0,4" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Genuine income"
                            FontSize="13"
                            TextColor="{StaticResource TextMuted}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding IncomeTotal}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Success}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Externally covered"
                            FontSize="13"
                            TextColor="{StaticResource TextMuted}" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding ExternalExpensesTotal}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Warning}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Income and spending -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Income and spending"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Your financial breakdown for this period."
                    FontSize="13"
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>

            <Border
                Padding="18"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="18">

                    <!-- Genuine income -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#2035D995"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Center">

                            <Image
                                Source="icons/income.svg"
                                WidthRequest="21"
                                HeightRequest="21"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="Genuine income"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Money received"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="{Binding IncomeTotal}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Success}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Border}" />

                    <!-- Personal expenses -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#2DF2390A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Center">

                            <Image
                                Source="icons/expense.svg"
                                WidthRequest="21"
                                HeightRequest="21"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="Personal expenses"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Paid from your own funds"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="{Binding PersonalExpensesTotal}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Border}" />

                    <!-- External expenses -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#2DF5B942"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Center">

                            <Image
                                Source="icons/building.svg"
                                WidthRequest="21"
                                HeightRequest="21"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label
                                Text="External expenses"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Covered by another source"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="{Binding ExternalExpensesTotal}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Warning}"
                            VerticalOptions="Center" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource Border}" />

                    <!-- Personal net -->
                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Personal net"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="{Binding PersonalNetTotal}"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource TextPrimary}" />

                        <Label
                            Text="Genuine income minus personal expenses."
                            FontSize="12"
                            TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- External funding by source -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Funding by source"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="See how much each employer or other source covered during this period."
                    FontSize="13"
                    TextColor="{StaticResource TextMuted}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <CollectionView
                ItemsSource="{Binding ExternalFunding}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Border
                        Padding="24"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout
                            Spacing="10"
                            HorizontalOptions="Center">

                            <Image
                                Source="icons/building.svg"
                                WidthRequest="30"
                                HeightRequest="30"
                                HorizontalOptions="Center" />

                            <Label
                                Text="No external funding yet"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="No externally funded expenses were recorded for this period."
                                FontSize="13"
                                TextColor="{StaticResource TextMuted}"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12">

                                <Border
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="#2DF5B942"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">

                                    <Image
                                        Source="icons/building.svg"
                                        WidthRequest="21"
                                        HeightRequest="21"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding SourceName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource TextPrimary}"
                                        LineBreakMode="WordWrap" />

                                    <Label
                                        Text="Expenses covered"
                                        FontSize="12"
                                        TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Amount}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Warning}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
