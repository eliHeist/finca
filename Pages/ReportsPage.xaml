<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Finance overview"
                FontSize="28"
                FontAttributes="Bold" />

            <Border
                Padding="16"
                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Report period"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label Text="Start date" />
                    <DatePicker Date="{Binding StartDate}" />

                    <Label Text="End date" />
                    <DatePicker Date="{Binding EndDate}" />

                    <Button
                        Text="Calculate report"
                        Command="{Binding RefreshCommand}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="Red"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="18"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#203A2A}"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Total income + funds covered"
                        FontSize="14" />

                    <Label
                        Text="{Binding TotalFunds}"
                        FontSize="28"
                        FontAttributes="Bold" />

                    <Label
                        Text="Genuine income plus expenses covered by external sources."
                        FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="Income and spending"
                FontSize="21"
                FontAttributes="Bold" />

            <Border
                Padding="16"
                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Genuine income" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding IncomeTotal}"
                            FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Personal expenses" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding PersonalExpensesTotal}"
                            FontAttributes="Bold" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="External expenses covered" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding ExternalExpensesTotal}"
                            FontAttributes="Bold" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Income minus personal expenses"
                            FontAttributes="Bold" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding PersonalNetTotal}"
                            FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label
                Text="External funding by source"
                FontSize="21"
                FontAttributes="Bold" />

            <Label
                Text="Expenses covered by each employer or other source during the selected period."
                FontSize="13" />

            <CollectionView
                ItemsSource="{Binding ExternalFunding}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No externally funded expenses in this period."
                        Padding="12"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,10"
                            Padding="16"
                            Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label
                                    Text="{Binding SourceName}"
                                    VerticalOptions="Center"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Amount}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
