<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Reports">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Finance overview"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Choose a period to calculate your finances."
                FontSize="14" />

            <Border
                Padding="16"
                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Report period"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label Text="Start date" />
                    <DatePicker Date="{Binding StartDate}" />

                    <Label Text="End date" />
                    <DatePicker Date="{Binding EndDate}" />

                    <Label Text="Daily allowance (UGX)" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding DailyAllowance}" />

                    <Label Text="Eligible allowance days in this period" />
                    <Entry
                        Keyboard="Numeric"
                        Text="{Binding EligibleDays}" />

                    <Button
                        Text="Calculate report"
                        Command="{Binding RefreshCommand}" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="Red"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="Income and spending"
                FontSize="21"
                FontAttributes="Bold" />

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Genuine income" FontSize="14" />
                    <Label
                        Text="{Binding IncomeTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Personal expenses" FontSize="14" />
                    <Label
                        Text="{Binding PersonalExpensesTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="External-funded expenses" FontSize="14" />
                    <Label
                        Text="{Binding ExternalExpensesTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="Allowance position"
                FontSize="21"
                FontAttributes="Bold" />

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Allowance earned" FontSize="14" />
                    <Label
                        Text="{Binding AllowanceEarnedTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                    <Label
                        Text="{Binding EligibleDaysLabel}"
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Income minus personal expenses" FontSize="14" />
                    <Label
                        Text="{Binding PersonalNetTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Allowance minus personal expenses" FontSize="14" />
                    <Label
                        Text="{Binding AllowancePositionTotal}"
                        FontSize="23"
                        FontAttributes="Bold" />
                    <Label
                        Text="Positive means allowance exceeds recorded personal expenses. Negative means spending exceeds allowance."
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
