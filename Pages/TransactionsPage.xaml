<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Transactions">

    <Grid Padding="16" RowDefinitions="Auto,Auto,*">
        <Label Text="All transactions"
               FontSize="26"
               FontAttributes="Bold" />

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               Margin="0,8" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Transactions}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No transactions recorded yet."
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,4"
                            Stroke="#D1D5DB"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Category}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Text="{Binding OccurredAt,
                                    StringFormat='{0:dd MMM yyyy}'}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Text="{Binding SourceName}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                <Label Text="{Binding Kind}"
                                       FontSize="12" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="10"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Amount,
                                    StringFormat='UGX {0:N0}'}"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End" />

                                <Button Text="Delete"
                                        FontSize="12"
                                        Padding="10,4"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
