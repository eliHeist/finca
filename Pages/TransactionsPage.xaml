<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Transactions"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid Padding="22,24"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="18">

        <!-- Header: back button and text inline -->
        <Grid Grid.Row="0"
              ColumnDefinitions="44,*"
              ColumnSpacing="14"
              VerticalOptions="Center">

            <Border
                Grid.Column="0"
                WidthRequest="44"
                HeightRequest="44"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                Padding="0"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Image
                    Source="icons/chevron_left.svg"
                    WidthRequest="20"
                    HeightRequest="20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="3"
                VerticalOptions="Center">

                <Label
                    Text="Transactions"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Review your income and expenses."
                    FontSize="13"
                    TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Error message -->
        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="{StaticResource Error}"
            FontSize="13"
            LineBreakMode="WordWrap" />

        <!-- Transaction list -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Transactions}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24"
                    Spacing="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Image
                        Source="icons/wallet.svg"
                        WidthRequest="48"
                        HeightRequest="48"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No transactions yet"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your income and expenses will appear here."
                        FontSize="13"
                        TextColor="{StaticResource TextMuted}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="6">

                            <!-- Transaction details -->
                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="TailTruncation" />

                                <Label
                                    Text="{Binding Category}"
                                    FontSize="13"
                                    TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>

                            <!-- Amount and options -->
                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                ColumnDefinitions="Auto,32"
                                ColumnSpacing="8"
                                HorizontalOptions="End"
                                VerticalOptions="Start">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Amount, StringFormat='UGX {0:N0}'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="End" />

                                <Button
                                    Grid.Column="1"
                                    Text="⋮"
                                    Clicked="OnOptionsClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextMuted}"
                                    FontSize="22"
                                    Padding="0"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    MinimumHeightRequest="32"
                                    MinimumWidthRequest="32"
                                    CornerRadius="16"
                                    VerticalOptions="Center" />
                            </Grid>

                            <!-- Type -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Kind}"
                                FontSize="12"
                                TextColor="{StaticResource Accent}" />

                            <!-- Date -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding OccurredAt, StringFormat='{0:dd MMM yyyy}'}"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}"
                                HorizontalTextAlignment="End" />

                            <!-- Source -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Text="{Binding SourceName}"
                                FontSize="12"
                                TextColor="{StaticResource TextMuted}"
                                LineBreakMode="TailTruncation" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
