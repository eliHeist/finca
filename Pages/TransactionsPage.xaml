<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.TransactionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Transactions"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.TabBarIsVisible="False">

    <Grid
        Padding="22,28"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="18">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="14">

            <Border
                WidthRequest="52"
                HeightRequest="52"
                BackgroundColor="#2DF2390A"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">

                <Image
                    Source="icons/building.svg"
                    WidthRequest="26"
                    HeightRequest="26"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">

                <Label
                    Text="Transactions"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{StaticResource TextPrimary}" />

                <Label
                    Text="Review your recorded income and expenses."
                    FontSize="13"
                    TextColor="{StaticResource TextMuted}"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>

        <!-- Error message -->
        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="{StaticResource Error}"
            FontSize="13"
            LineBreakMode="WordWrap" />

        <!-- Transactions list -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Transactions}"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="24"
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Border
                        WidthRequest="64"
                        HeightRequest="64"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        HorizontalOptions="Center">

                        <Image
                            Source="icons/wallet.svg"
                            WidthRequest="30"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Text="No transactions yet"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your recorded income and expenses will appear here."
                        FontSize="13"
                        TextColor="{StaticResource TextMuted}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="14"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12">

                            <!-- Transaction icon -->
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="#2035D995"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 13"
                                VerticalOptions="Start">

                                <Image
                                    Source="icons/income.svg"
                                    WidthRequest="23"
                                    HeightRequest="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <Image.Triggers>
                                        <DataTrigger
                                            TargetType="Image"
                                            Binding="{Binding Kind}"
                                            Value="Expense">
                                            <Setter
                                                Property="Source"
                                                Value="icons/expense.svg" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <Border.Triggers>
                                    <DataTrigger
                                        TargetType="Border"
                                        Binding="{Binding Kind}"
                                        Value="Expense">
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="#2DF2390A" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- Transaction details -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource TextPrimary}"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Text="{Binding Category}"
                                    FontSize="12"
                                    TextColor="{StaticResource TextMuted}"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Text="{Binding OccurredAt,
                                        StringFormat='{0:dd MMM yyyy}'}"
                                    FontSize="12"
                                    TextColor="{StaticResource TextMuted}" />

                                <Label
                                    Text="{Binding SourceName}"
                                    FontSize="12"
                                    TextColor="{StaticResource Warning}"
                                    LineBreakMode="WordWrap" />

                                <Label
                                    Text="{Binding Kind}"
                                    FontSize="11"
                                    TextColor="{StaticResource Success}">

                                    <Label.Triggers>
                                        <DataTrigger
                                            TargetType="Label"
                                            Binding="{Binding Kind}"
                                            Value="Expense">
                                            <Setter
                                                Property="TextColor"
                                                Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Delete -->
                                <Button
                                    Text="Delete transaction"
                                    FontSize="12"
                                    Padding="10,5"
                                    HeightRequest="34"
                                    HorizontalOptions="Start"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Error}"
                                    BorderColor="{StaticResource Border}"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout>

                            <!-- Amount -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding Amount,
                                    StringFormat='UGX {0:N0}'}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Success}"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Start"
                                LineBreakMode="WordWrap">

                                <Label.Triggers>
                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding Kind}"
                                        Value="Expense">
                                        <Setter
                                            Property="TextColor"
                                            Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
