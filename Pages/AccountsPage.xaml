<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
    x:DataType="vm:AccountsViewModel"
    Title="Accounts"
    BackgroundColor="{StaticResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="20">

        <!-- Header -->
        <Grid ColumnDefinitions="48,*"
              ColumnSpacing="14"
              VerticalOptions="Center">

            <Border WidthRequest="44"
                    HeightRequest="44"
                    Padding="10"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    VerticalOptions="Start">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </Border.GestureRecognizers>

                <Image Source="icons/chevron_left.png"
                       Aspect="AspectFit"
                       WidthRequest="22"
                       HeightRequest="22" />
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="5">
                <Label Text="Your accounts"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />

                <Label Text="Personal accounts and external funding activity."
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Error message -->
        <Border Grid.Row="1"
                Padding="12"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Error}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Error}"
                   FontSize="13" />
        </Border>

        <!-- Accounts list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Accounts}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12"
                                     Padding="24"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Image Source="icons/wallet.svg"
                           WidthRequest="48"
                           HeightRequest="48"
                           HorizontalOptions="Center"
                           Opacity="0.7" />

                    <Label Text="No accounts found"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Your accounts will appear here."
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">

                    <Border Padding="16"
                            Margin="0,0,0,14"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="16">

                            <!-- Account details -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />

                                    <Label Text="{Binding Type}"
                                           FontSize="12"
                                           TextColor="{StaticResource Accent}" />

                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMuted}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6"
                                                     HorizontalOptions="End">

                                    <Label Text="{Binding Balance}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalTextAlignment="End" />

                                    <Label Text="{Binding IsActive,
                                                StringFormat='Active: {0}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextMuted}"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Border}" />

                            <!-- Account actions -->
                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">

                                <Button Text="Rename"
                                        Clicked="OnRenameClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource Surface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        BorderColor="{StaticResource Border}"
                                        BorderWidth="1"
                                        CornerRadius="12"
                                        HeightRequest="44" />

                                <Button Grid.Column="1"
                                        Text="{Binding StatusAction}"
                                        Clicked="OnToggleActiveClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#2DF2390A"
                                        TextColor="{StaticResource Accent}"
                                        BorderColor="{StaticResource Accent}"
                                        BorderWidth="1"
                                        CornerRadius="12"
                                        HeightRequest="44" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
