<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FinanceTracker.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:FinanceTracker.ViewModels"
    x:DataType="vm:AccountsViewModel"
    Title="Accounts">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="16">

        <VerticalStackLayout Spacing="4">
            <Label Text="Your accounts"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="Personal and external funding activity."
                   TextColor="Gray" />
        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="Red" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Accounts}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No accounts found."
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountRow">
                    <Border Padding="16"
                            Margin="0,0,0,12"
                            Stroke="#DDDDDD"
                            StrokeThickness="1">

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Type}"
                                           TextColor="Gray"
                                           FontSize="12" />

                                    <Label Text="{Binding Description}"
                                           TextColor="Gray"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     HorizontalOptions="End">
                                    <Label Text="{Binding Balance}"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End" />

                                    <Label Text="{Binding IsActive,
                                        StringFormat='Active: {0}'}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">
                                <Button Text="Rename"
                                        Clicked="OnRenameClicked"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="{Binding StatusAction}"
                                        Clicked="OnToggleActiveClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
